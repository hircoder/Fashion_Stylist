# copy to .env and fill in what you need. everything has a default.

# --- llm (pick one provider, or none for the regex-only mode) ---
# LLM_PROVIDER=anthropic            # anthropic | openai | none (default: picked from the keys below)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# LLM_MODEL=claude-opus-5           # default per provider: claude-opus-5 / gpt-5-mini
#                                   # cheaper + faster: claude-sonnet-5, claude-haiku-4-5, gpt-5-mini
# LLM_EFFORT=low                    # reasoning effort for reasoning models (low|medium|high)
# OPENAI_BASE_URL=                  # any openai-compatible endpoint (tested: azure openai /openai/v1/)
# ANTHROPIC_BASE_URL=               # e.g. an azure foundry anthropic endpoint

# --- data / index ---
# DATA_DIR=data
# INDEX_DIR=data/index              # e.g. data/demo/index after `make demo`
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
# EMBEDDER=sentence-transformers    # hash = offline test embedder, lexical only
# EMBED_DEVICE=                     # cpu | mps | cuda (auto)

# --- request handling ---
# REQUEST_DEADLINE_S=40
# PLANNER_BUDGET_S=15
# RERANK_BUDGET_S=20
# RETRIEVAL_CONCURRENCY=4
# TOP_N_PER_CHANNEL=100
# RERANK_CANDIDATES=10
# KEYWORD_BOOST=0.5                 # in units of a rank-1 rrf hit
# QUALITY_WEIGHT=0.1
# LOG_LEVEL=INFO

# --- deployments without a local index (railway etc.) ---
# INDEX_URL=https://.../index.tar.gz
# INDEX_SHA256=...
# INDEX_MAX_BYTES=4294967296
